#the mod name as displayed in-game
displayName: "Better Mining"

#the internal name of your mod
name: "example-java-mod"

#your name
author: "SiliconDevil"

#the fully qualified main class of the mod
main: "example.BetterMiningMod"

#the mod description as seen in the mod dialog
description: "Enables mining with a full inventory and auto-mining with configurable ores via keybind."

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true

hidden: true
